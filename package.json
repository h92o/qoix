{
  "name": "qoix-synthesizer",
  "productName": "QOIX Synthesizer",
  "version": "1.0.0",
  "description": "QOIX \u2014 Professional software synthesizer. FM, Wavetable, Oxford Harmonic, Mod Matrix.",
  "main": "main.js",
  "author": {
    "name": "QOIX",
    "email": "hello@qoix.app"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder build --publish never",
    "build:mac": "electron-builder build --mac --publish never",
    "build:win": "electron-builder build --win --publish never",
    "build:linux": "electron-builder build --linux --publish never",
    "build:all": "electron-builder build -mwl --publish never",
    "dist": "electron-builder build --publish always",
    "pack": "electron-builder --dir",
    "test": "node test/run.js",
    "standalone": "node tools/build-standalone.js",
    "test:browser": "node test/browser.js",
    "test:all": "npm test && npm run test:browser",
    "lint": "eslint .",
    "check": "npm run lint && npm test"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^9.0.0"
  },
  "build": {
    "appId": "app.qoix.synthesizer",
    "productName": "QOIX Synthesizer",
    "copyright": "Copyright \u00a9 2025 QOIX",
    "asar": true,
    "files": [
      "index.html",
      "styles.css",
      "main.js",
      "preload.js",
      "js/**/*",
      "assets/**/*",
      "!node_modules",
      "!dist",
      "!build",
      "!test",
      "!tools"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "darkModeSupport": true,
      "minimumSystemVersion": "12.0"
    },
    "dmg": {
      "title": "QOIX Synthesizer",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 180,
          "type": "file"
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Audio",
      "desktop": {
        "Name": "QOIX Synthesizer",
        "Comment": "Professional software synthesizer",
        "Categories": "Audio;Music;AudioVideo;"
      }
    },
    "publish": {
      "provider": "github",
      "owner": "h92o",
      "repo": "qoix"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
