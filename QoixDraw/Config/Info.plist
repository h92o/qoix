<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Makes the app's Documents folder show up in the Files app (On My iPhone > QOIX Draw).
	     Drawings land there when the photo library can't be used. Everything else in the
	     Info.plist is generated from the build settings in the Xcode project. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
